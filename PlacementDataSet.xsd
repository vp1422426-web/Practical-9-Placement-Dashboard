<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="PlacementDataSet" targetNamespace="http://tempuri.org/PlacementDataSet.xsd"
           xmlns:mstns="http://tempuri.org/PlacementDataSet.xsd"
           xmlns="http://tempuri.org/PlacementDataSet.xsd"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:msdata="urn:schemas-microsoft-com:xml-msdata"
           attributeFormDefault="qualified" elementFormDefault="qualified">
  <xs:element name="PlacementDataSet" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Placements">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="PlacementId" type="xs:int" />
              <xs:element name="StudentName" type="xs:string" />
              <xs:element name="Department" type="xs:string" />
              <xs:element name="Company" type="xs:string" />
              <xs:element name="PackageLPA" type="xs:decimal" />
              <xs:element name="PlacementStatus" type="xs:string" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:complexType>
  </xs:element>
</xs:schema>
